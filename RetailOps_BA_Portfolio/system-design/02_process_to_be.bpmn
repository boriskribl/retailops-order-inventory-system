<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RetailOps" targetNamespace="https://example.invalid/retailops/bpmn"><bpmn:process id="Process_OrderToDelivery" name="RetailOps — Order to delivery (TO-BE)" isExecutable="false"><bpmn:laneSet id="LaneSet1"><bpmn:lane id="Sales_lane" name="Sales channel"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Inventory_lane" name="Inventory service"><bpmn:flowNodeRef>CheckStock</bpmn:flowNodeRef><bpmn:flowNodeRef>GatewayStock</bpmn:flowNodeRef><bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Warehouse_lane" name="Warehouse operations"><bpmn:flowNodeRef>CreateFulfillment</bpmn:flowNodeRef><bpmn:flowNodeRef>Dispatch</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Carrier_lane" name="Courier / support"><bpmn:flowNodeRef>ConfirmDelivery</bpmn:flowNodeRef><bpmn:flowNodeRef>EndSuccess</bpmn:flowNodeRef><bpmn:flowNodeRef>EndFailure</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Order received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Validate" name="Validate order + address"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="CheckStock" name="Read available stock"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="GatewayStock" name="All lines available?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Reserve" name="Atomically reserve stock"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="CreateFulfillment" name="Create warehouse fulfillments"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="Dispatch" name="Dispatch + decrement stock"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="ConfirmDelivery" name="Confirm delivered timestamp"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:endEvent id="EndSuccess" name="Delivered"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent><bpmn:task id="Reject" name="Reject: no stock / rollback"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task><bpmn:endEvent id="EndFailure" name="Order remains NEW"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Validate" /><bpmn:sequenceFlow id="Flow_2" sourceRef="Validate" targetRef="CheckStock" /><bpmn:sequenceFlow id="Flow_3" sourceRef="CheckStock" targetRef="GatewayStock" /><bpmn:sequenceFlow id="Flow_4" sourceRef="GatewayStock" targetRef="Reserve" name="Yes" /><bpmn:sequenceFlow id="Flow_5" sourceRef="GatewayStock" targetRef="Reject" name="No" /><bpmn:sequenceFlow id="Flow_6" sourceRef="Reserve" targetRef="CreateFulfillment" /><bpmn:sequenceFlow id="Flow_7" sourceRef="CreateFulfillment" targetRef="Dispatch" /><bpmn:sequenceFlow id="Flow_8" sourceRef="Dispatch" targetRef="ConfirmDelivery" /><bpmn:sequenceFlow id="Flow_9" sourceRef="ConfirmDelivery" targetRef="EndSuccess" /><bpmn:sequenceFlow id="Flow_10" sourceRef="Reject" targetRef="EndFailure" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram1"><bpmndi:BPMNPlane id="BPMNPlane1" bpmnElement="Process_OrderToDelivery"><bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="92" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate"><dc:Bounds x="245" y="87" width="140" height="46" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="CheckStock_di" bpmnElement="CheckStock"><dc:Bounds x="420" y="199" width="140" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="GatewayStock_di" bpmnElement="GatewayStock"><dc:Bounds x="600" y="197" width="55" height="55" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reserve_di" bpmnElement="Reserve"><dc:Bounds x="700" y="199" width="155" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="CreateFulfillment_di" bpmnElement="CreateFulfillment"><dc:Bounds x="885" y="324" width="170" height="52" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Dispatch_di" bpmnElement="Dispatch"><dc:Bounds x="1090" y="324" width="165" height="52" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="ConfirmDelivery_di" bpmnElement="ConfirmDelivery"><dc:Bounds x="1290" y="455" width="160" height="52" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="EndSuccess_di" bpmnElement="EndSuccess"><dc:Bounds x="1500" y="463" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject"><dc:Bounds x="705" y="92" width="160" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="EndFailure_di" bpmnElement="EndFailure"><dc:Bounds x="930" y="96" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="156" y="110.0" /><di:waypoint x="245" y="110.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="385" y="110.0" /><di:waypoint x="420" y="224.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="560" y="224.0" /><di:waypoint x="600" y="224.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="655" y="224.5" /><di:waypoint x="700" y="224.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="655" y="224.5" /><di:waypoint x="705" y="117.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="855" y="224.0" /><di:waypoint x="885" y="350.0" 